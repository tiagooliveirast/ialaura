# Copie para apps/web/.env.local e preencha. Na Vercel, cadastre em Settings → Environment Variables.

# Banco compartilhado com a Helô (Supabase do projeto refriclube → Settings → API)
LAURA_SUPABASE_URL=
LAURA_SUPABASE_ANON_KEY=
LAURA_SUPABASE_SERVICE_ROLE_KEY=

# Banco de teste antigo (ialaura-dev). Usado só se as LAURA_* acima estiverem vazias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# (a integração da Vercel pode criar SUPABASE_SECRET_KEY no lugar; o código aceita as duas)

# WhatsApp Cloud API (Meta for Developers → seu app)
WHATSAPP_APP_SECRET=
# Texto que você inventa e repete no cadastro do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Token de acesso do app (usuário do sistema, permanente) para enviar mensagens
WHATSAPP_ACCESS_TOKEN=
# Opcional: versão da Graph API (padrão v25.0)
WHATSAPP_GRAPH_VERSION=

# OpenAI
OPENAI_API_KEY=
# Opcional: modelo (padrão gpt-4o-mini) e preço por 1 milhão de tokens, para o custo em laura.uso_ia
OPENAI_MODEL=
OPENAI_PRECO_ENTRADA_1M=
OPENAI_PRECO_SAIDA_1M=

# Mercado Pago (assinatura). Webhook: https://SEU_SITE/api/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 1 = bloqueia quem não pagou. Deixe vazio até a cobrança estar testada.
COBRANCA_ATIVA=

# Protege a rotina diária /api/cron/diario (a Vercel envia como Bearer). Sem ela, lembretes não saem.
CRON_SECRET=

# Opcional: cotação usada no admin para mostrar o custo de IA em reais (padrão 5.5)
COTACAO_DOLAR=
